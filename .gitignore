# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Jupyter Notebook checkpoints (auto-saved notebook states)
.ipynb_checkpoints/

# Editor and IDE settings
.vscode/
.idea/

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Don't include any data files
*.zarr
*.zip
# session scratch
.remember/

# staged workshop data (downloaded, not tracked)
notebooks/day_1/data/*
!notebooks/day_1/data/README.md
notebooks/day_2/spatialdata/data/*
!notebooks/day_2/spatialdata/data/README.md

# day-2 morning data (presenters' own) and notebook outputs
notebooks/day_2/data/
notebooks/day_2/outputs/

# artefacts written by running the notebooks
notebooks/**/datasets/
notebooks/**/*.h5ad
notebooks/**/*.zarr/
notebooks/**/.pybiomart.sqlite
# pixi environments
.pixi/*
!.pixi/config.toml

# squidpy / pertpy download caches (created relative to the notebook cwd)
/data/
notebooks/day_2/spatialdata/advanced/data/
